# Public origin must match the browser URL exactly. Change both when changing ports.
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
MAX_UPLOAD_GB=50
MAX_CONCURRENT_UPLOADS=2
DATABASE_POOL_MAX_CONNS=10

# Optional external disk. scripts/setup.sh --pi --data-dir /mnt/ssd/romvault
# creates the directories and sets COMPOSE_FILE automatically.
# DATA_DIR=/mnt/ssd/romvault
# COMPOSE_FILE=docker-compose.yaml:docker-compose.storage.yaml:docker-compose.rpi.yaml
# COMPOSE_PARALLEL_LIMIT=1

# scripts/setup.ps1 generates strong local secrets without overwriting an existing .env.
POSTGRES_USER=romvault
POSTGRES_DB=romvault
POSTGRES_PASSWORD=replace-with-a-random-password
REDIS_PASSWORD=replace-with-a-random-password
S3_ACCESS_KEY=romvault
S3_SECRET_KEY=replace-with-a-random-password
S3_BUCKET=romvault
SEAWEED_IMAGE=chrislusf/seaweedfs:4.17
ADMIN_EMAIL=admin@romvault.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Only used with docker-compose.dev.yaml
POSTGRES_PORT=5433
REDIS_PORT=6379
S3_PORT=8333
API_PORT=8001
